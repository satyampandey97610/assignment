# Database connection strings (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/care
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/care_test

# LLM provider configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LLM mode: replay (works offline without API keys), record, or live
LLM_MODE=replay

# Embeddings configuration (local multilingual-e5-small)
EMBED_MODEL=intfloat/multilingual-e5-small
SIM_THRESHOLD=0.80

# Timeouts & safety limits
SAFETY_TIMEOUT_S=4.0
LLM_TIMEOUT_S=20.0
DB_STATEMENT_TIMEOUT_MS=5000
TOOL_CALL_CAP=4
SAFETY_REGEX_UNION=true

LOG_LEVEL=INFO
